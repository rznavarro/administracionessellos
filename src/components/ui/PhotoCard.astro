---
import { Picture } from 'astro:assets';
import { imagen } from '../../data/images';

// Tarjeta con foto 4:3 arriba, título y una línea de texto. Mismo estilo que FeatureCard
interface Props {
  foto: string;
  alt: string;
  title: string;
  text: string;
  delay?: number;
}

const { foto, alt, title, text, delay = 0 } = Astro.props;
---

<article
  class="rv group overflow-hidden rounded-2xl border border-g4/70 bg-white transition duration-300 hover:-translate-y-1 hover:border-b3/50 hover:shadow-[var(--shadow-lift)]"
  data-delay={String(delay)}
>
  <div class="aspect-[4/3] overflow-hidden bg-g5">
    <Picture
      src={imagen(foto)}
      alt={alt}
      formats={['avif', 'webp']}
    fallbackFormat="webp"
      widths={[480, 720, 960]}
      sizes="(min-width: 1024px) 280px, (min-width: 640px) 45vw, 92vw"
      loading="lazy"
      decoding="async"
      class="size-full object-cover transition duration-700 ease-out group-hover:scale-105"
    />
  </div>
  <div class="p-5">
    <h3 class="text-[16px] font-semibold leading-snug tracking-[-0.015em] text-g1">{title}</h3>
    <p class="mt-1.5 text-[14px] leading-relaxed text-g3">{text}</p>
  </div>
</article>
