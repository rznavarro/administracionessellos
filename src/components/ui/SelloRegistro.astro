---
import { site } from '../../data/site';
import { icons } from '../../lib/icons';

const { contact } = site;
const Icon = icons.badgeCheck;
---

<!-- Solo se muestra con la inscripción real en site.ts (registry y registryNumber). Sin logo ni escudo del MINVU -->
{
  contact.registry && contact.registryNumber && (
    <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-[13px] font-medium text-white/90 ring-1 ring-white/20">
      <Icon size={16} strokeWidth={1.8} class="text-[#A9C8EC]" aria-hidden="true" />
      {contact.registry} · N° {contact.registryNumber}
    </p>
  )
}
