---
import { CircleCheck, CircleX } from 'lucide-react';
import { site } from '../../data/site';
import { rich } from '../../lib/rich';
import SectionHeader from '../ui/SectionHeader.astro';
import ScrollVelocity from '../reactbits/ScrollVelocity';
import GradientText from '../reactbits/GradientText';

const { gastoComun } = site;
// El sello tiene una frase marcada con **…**: esa parte va con GradientText
const [selloBefore, selloMarked = '', selloAfter = ''] = gastoComun.sello.split(/\*\*(.+?)\*\*/);
const band = gastoComun.band.join('  ✦  ');
---

<section id="ggcc" class="cv-auto relative overflow-hidden bg-white py-24 lg:py-32" style="--cv-h: 1800px; --cv-h-lg: 1370px">
  <div class="container-x">
    <SectionHeader tag={gastoComun.tag} title={gastoComun.title} />
  </div>

  <div class="my-14 border-y border-g4/60 py-6" aria-hidden="true">
    <ScrollVelocity
      client:visible
      texts={[band, band]}
      velocity={40}
      numCopies={4}
      outlineAlternate
      fadeEdges
      className="px-4"
      scrollerClassName="!font-sans !text-[clamp(2.4rem,7vw,5.4rem)] !leading-[1.05] !drop-shadow-none text-b1"
    />
  </div>

  <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
    <div class="space-y-5">
      {
        gastoComun.paragraphs.map((paragraph, i) => (
          <p
            class="rv text-pretty text-[16px] leading-[1.9] text-g2 [&_strong]:text-g1"
            data-delay={String(i * 0.06)}
            set:html={rich(paragraph)}
          />
        ))
      }
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="rv rounded-2xl border border-danger/15 bg-danger2/60 p-6">
        <h3 class="text-[13px] font-semibold uppercase tracking-[0.14em] text-danger">{gastoComun.compare.bad.title}</h3>
        <ul class="mt-4 space-y-2.5">
          {
            gastoComun.compare.bad.items.map(item => (
              <li class="flex items-start gap-2.5 text-[14px] leading-snug text-g2">
                <CircleX size={17} className="mt-px shrink-0 text-danger" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rv rounded-2xl border border-gr/20 bg-gr2/60 p-6" data-delay="0.08">
        <h3 class="text-[13px] font-semibold uppercase tracking-[0.14em] text-gr">{gastoComun.compare.good.title}</h3>
        <ul class="mt-4 space-y-2.5">
          {
            gastoComun.compare.good.items.map(item => (
              <li class="flex items-start gap-2.5 text-[14px] leading-snug text-g2">
                <CircleCheck size={17} className="mt-px shrink-0 text-gr" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="container-x mt-12">
    <div class="rv on-dark relative overflow-hidden rounded-3xl bg-b1 px-7 py-10 text-center sm:px-14 sm:py-14">
      <div class="grid-lines pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <p class="relative mx-auto max-w-3xl text-balance text-[clamp(1.25rem,2.6vw,1.9rem)] font-medium leading-[1.45] tracking-[-0.02em] text-white/85">
        {selloBefore}
        <GradientText client:visible inline colors={['#A9C8EC', '#4ADE80', '#A9C8EC']} animationSpeed={6} className="font-semibold">
          {selloMarked}
        </GradientText>
        {selloAfter}
      </p>
    </div>
  </div>
</section>
