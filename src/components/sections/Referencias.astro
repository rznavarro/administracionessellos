---
import { getImage } from 'astro:assets';
import { site } from '../../data/site';
import { imagen } from '../../data/images';
import SectionHeader from '../ui/SectionHeader.astro';
import Referencias from '../islands/Referencias';

const { referencias } = site;
// Convierte `foto` (nombre en src/assets/imagenes) en una URL optimizada para la isla de React
const items = await Promise.all(
  referencias.items.map(async item => ({
    ...item,
    image: item.foto ? (await getImage({ src: imagen(item.foto), width: 660, format: 'webp' })).src : undefined
  }))
);
---

<!-- Sin items en site.ts no se muestra la sección -->
{
  items.length > 0 && (
    <section id="referencias" class="cv-auto relative overflow-hidden bg-b6 py-24 lg:py-32" style="--cv-h: 700px; --cv-h-lg: 700px">
      <div class="container-x">
        <SectionHeader tag={referencias.tag} title={referencias.title} text={referencias.text} align="center" />
      </div>
      <div class="mt-14">
        <Referencias client:visible items={items} />
      </div>
    </section>
  )
}
