---
import { ArrowRight, Plus } from 'lucide-react';
import { site, whatsappUrl } from '../../data/site';
import { rich } from '../../lib/rich';
import SectionHeader from '../ui/SectionHeader.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon';

const { faq, contact } = site;
---

<section id="faq" class="cv-auto relative bg-g6 py-24 lg:py-32" style="--cv-h: 1770px; --cv-h-lg: 1280px">
  <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <SectionHeader tag={faq.tag} title={faq.title} />
      <div class="rv mt-8 rounded-2xl border border-g4/70 bg-white p-6 shadow-[var(--shadow-soft)]" data-delay="0.15">
        <h3 class="text-[16px] font-semibold text-g1">{faq.helpTitle}</h3>
        <p class="mt-1.5 text-[14px] leading-relaxed text-g3">{faq.helpText}</p>
        {
          contact.whatsapp ? (
            <a
              href={whatsappUrl()}
              target="_blank"
              rel="noopener noreferrer"
              data-track="whatsapp_click"
              data-origen="faq"
              class="mt-5 inline-flex h-11 items-center gap-2 rounded-xl bg-wa px-5 text-[14px] font-semibold text-[#073b1f] transition hover:-translate-y-0.5"
            >
              <WhatsAppIcon size={17} /> Escríbenos por WhatsApp
            </a>
          ) : (
            <a
              href="#form"
              class="mt-5 inline-flex h-11 items-center gap-2 rounded-xl bg-b1 px-5 text-[14px] font-semibold text-white transition hover:-translate-y-0.5 hover:bg-b2"
            >
              Déjanos tu consulta <ArrowRight size={16} aria-hidden="true" />
            </a>
          )
        }
        {
          contact.phoneHref && (
            <p class="mt-4 text-[13px] text-g3">
              o llámanos al{' '}
              <a href={contact.phoneHref} class="font-medium text-b2 hover:underline">
                {contact.phoneDisplay}
              </a>
            </p>
          )
        }
      </div>
    </div>

    <div class="divide-y divide-g4/70 rounded-2xl border border-g4/70 bg-white px-5 shadow-[var(--shadow-soft)] sm:px-8">
      {
        faq.items.map(item => (
          <details name="faq" class="faq-item group">
            <summary class="flex cursor-pointer items-center justify-between gap-6 py-5 text-left text-[15.5px] font-semibold leading-snug tracking-[-0.01em] text-g1 transition hover:text-b2 group-open:text-b2">
              {item.q}
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-b5 text-b2 transition duration-300 group-open:rotate-45 group-open:bg-b1 group-open:text-white">
                <Plus size={16} aria-hidden="true" />
              </span>
            </summary>
            <div class="prose-rich pb-6 pr-10 text-[14.5px] leading-[1.85] text-g3" set:html={rich(item.a)} />
          </details>
        ))
      }
    </div>
  </div>
</section>
