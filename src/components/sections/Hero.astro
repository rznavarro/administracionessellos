---
import { Picture } from 'astro:assets';
import { site, whatsappUrl } from '../../data/site';
import { imagen } from '../../data/images';
import { icons } from '../../lib/icons';
import HeroForm from '../islands/HeroForm';
import Button from '../ui/Button.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon';

const { hero, form, contact } = site;
---

<section id="inicio" class="on-dark relative isolate overflow-hidden bg-[#1a1a1a] text-white">
  <!-- La foto es el LCP: carga con prioridad. El lado izquierdo de la imagen es oscuro y queda bajo el texto -->
  <Picture
    src={imagen(hero.image.name)}
    alt={hero.image.alt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[68%_center]"
  />
  <!-- Sombra neutra (sin tinte azul) para que el texto blanco se lea sobre la foto -->
  <div class="absolute inset-0 -z-10 bg-black/40 lg:bg-gradient-to-r lg:from-black/55 lg:via-black/30 lg:to-black/20" aria-hidden="true"></div>

  <!-- Móvil: titular → formulario → beneficios. Escritorio: texto a la izquierda y formulario a la derecha -->
  <div class="container-x grid gap-x-12 gap-y-8 pb-14 pt-24 sm:pt-28 lg:grid-cols-12 lg:items-center lg:pb-20 lg:pt-32">
    <div class="lg:col-span-7">
      <h1 class="text-[clamp(2.15rem,4.6vw,3.6rem)] font-bold leading-[1.05] tracking-[-0.04em]">
        <span class="animate-blur-in block">{hero.titleLead}</span>
        <span
          class="animate-blur-in mt-1 block font-serif text-[1.06em] font-normal italic leading-[1.1] tracking-[-0.01em] text-[#A9C8EC] [animation-delay:120ms]"
        >
          {hero.titleAccent}
        </span>
      </h1>

      <p class="animate-blur-in mt-5 max-w-xl text-pretty text-[17px] leading-[1.6] text-white/75 [animation-delay:240ms]">
        {hero.subtitle}
      </p>

      {
        contact.whatsapp && (
          <div class="animate-blur-in mt-7 hidden [animation-delay:320ms] lg:block">
            <Button
              href={whatsappUrl()}
              variant="whatsapp"
              size="lg"
              target="_blank"
              rel="noopener noreferrer"
              data-track="whatsapp_click"
              data-origen="hero"
            >
              <WhatsAppIcon size={19} />
              Escribir por WhatsApp
            </Button>
          </div>
        )
      }
    </div>

    <div id="form" class="animate-blur-in lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 [animation-delay:160ms]">
      <HeroForm
        client:load
        endpoint={form.endpoint}
        title={form.title}
        subtitle={form.subtitle}
        submit={form.submit}
        trust={form.trust}
        error={form.error}
        success={form.success}
        whatsapp={contact.whatsapp}
      />
    </div>

    <ul class="animate-blur-in grid gap-3 sm:grid-cols-3 lg:col-span-7 lg:self-start [animation-delay:400ms]">
      {
        hero.benefits.map(benefit => {
          const Icon = icons[benefit.icon];
          return (
            <li class="flex items-center gap-3 text-[14px] font-medium text-white/85">
              <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-white/10 text-[#A9C8EC] ring-1 ring-white/15">
                <Icon size={18} strokeWidth={1.8} aria-hidden="true" />
              </span>
              {benefit.label}
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/25 to-transparent" aria-hidden="true"></div>
</section>
