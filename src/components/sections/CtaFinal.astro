---
import { Picture } from 'astro:assets';
import { ArrowRight } from 'lucide-react';
import { site, whatsappUrl } from '../../data/site';
import { imagen } from '../../data/images';
import Button from '../ui/Button.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon';
import Magnet from '../reactbits/Magnet';

const { cta, contact } = site;
---

<section id="cta" class="cv-auto on-dark relative isolate overflow-hidden bg-[#0B1626] py-24 text-white lg:py-32" style="--cv-h: 560px; --cv-h-lg: 520px">
  <Picture
    src={imagen(cta.image.name)}
    alt={cta.image.alt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <!-- Capa oscura neutra: la foto es cálida y el texto blanco tiene que leerse -->
  <div class="absolute inset-0 -z-10 bg-black/60" aria-hidden="true"></div>

  <div class="container-x max-w-3xl text-center">
    <h2 class="rv text-balance text-[clamp(2rem,4.8vw,3.3rem)] font-bold leading-[1.06] tracking-[-0.035em]">
      {cta.title}
    </h2>
    <p class="rv mx-auto mt-6 max-w-2xl text-pretty text-[16.5px] leading-[1.8] text-white/70" data-delay="0.08">
      {cta.text}
    </p>
    <div class="rv mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row" data-delay="0.15">
      <Magnet client:visible padding={70} magnetStrength={5} maxOffset={14}>
        <Button href="#form" variant="white" size="lg">
          {cta.primary}
          <ArrowRight size={18} className="transition group-hover/btn:translate-x-1" />
        </Button>
      </Magnet>
      {
        contact.whatsapp && (
          <Magnet client:visible padding={70} magnetStrength={5} maxOffset={14}>
            <Button
              href={whatsappUrl()}
              variant="whatsapp"
              size="lg"
              target="_blank"
              rel="noopener noreferrer"
              data-track="whatsapp_click"
              data-origen="cta"
            >
              <WhatsAppIcon size={19} />
              {cta.whatsapp}
            </Button>
          </Magnet>
        )
      }
    </div>
  </div>
</section>
