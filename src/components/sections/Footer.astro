---
import { ArrowUp, Mail, MapPin, Phone, Clock } from 'lucide-react';
import { site, whatsappUrl } from '../../data/site';
import WhatsAppIcon from '../ui/WhatsAppIcon';

const { footer, brand, contact, comunas, socials } = site;
const year = new Date().getFullYear();
const hasContact = Boolean(contact.phoneHref || contact.whatsapp || contact.email || contact.hours || comunas.length);
---

<footer class="cv-auto on-dark relative overflow-hidden bg-[#0B1626] text-white/65" style="--cv-h: 700px; --cv-h-lg: 560px">
  <div class="container-x">
    <div class="flex flex-col gap-12 py-14 lg:flex-row lg:items-start lg:justify-between lg:gap-16">
      <div class="lg:max-w-sm">
        <a href="#inicio" class="inline-block transition-opacity hover:opacity-85">
          <img src={brand.logo.src} width={brand.logo.width} height={brand.logo.height} alt={brand.logo.alt} class="h-11 w-auto" loading="lazy" />
        </a>
        <p class="mt-3 font-serif text-[15px] italic tracking-[0.02em] text-white/80">{brand.tagline}</p>
        <p class="mt-5 max-w-xs text-[13.5px] leading-relaxed">{footer.description}</p>
        {
          contact.registry && (
            <p class="mt-5 inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-3.5 py-2 text-[11.5px] leading-snug text-white/70">
              <span class="size-1.5 rounded-full bg-[#4ADE80]" aria-hidden="true" />
              {contact.registry}
              {contact.registryNumber && ` N° ${contact.registryNumber}`}
            </p>
          )
        }
        {
          socials.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {socials.map(social => (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex rounded-full border border-white/15 px-3.5 py-1.5 text-[12.5px] text-white/75 transition hover:border-white/40 hover:text-white"
                  >
                    {social.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        hasContact && (
          <div>
            <h3 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-white/60">Contacto</h3>
            <ul class="mt-5 space-y-3.5 text-[14px]">
              {contact.phoneHref && (
                <li>
                  <a href={contact.phoneHref} class="flex items-center gap-2.5 transition hover:text-white">
                    <Phone size={15} className="text-white/40" aria-hidden="true" />
                    {contact.phoneDisplay}
                  </a>
                </li>
              )}
              {contact.whatsapp && (
                <li>
                  <a
                    href={whatsappUrl()}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track="whatsapp_click"
                    data-origen="footer"
                    class="flex items-center gap-2.5 transition hover:text-white"
                  >
                    <WhatsAppIcon size={15} className="text-white/40" />
                    WhatsApp
                  </a>
                </li>
              )}
              {contact.email && (
                <li>
                  <a href={`mailto:${contact.email}`} class="flex items-center gap-2.5 break-all transition hover:text-white">
                    <Mail size={15} className="shrink-0 text-white/40" aria-hidden="true" />
                    {contact.email}
                  </a>
                </li>
              )}
              {contact.hours && (
                <li class="flex items-center gap-2.5">
                  <Clock size={15} className="text-white/40" aria-hidden="true" />
                  {contact.hours}
                </li>
              )}
              {comunas.length > 0 && (
                <li class="flex items-start gap-2.5">
                  <MapPin size={15} className="mt-0.5 shrink-0 text-white/40" aria-hidden="true" />
                  <span class="leading-relaxed">{comunas.join(' · ')}</span>
                </li>
              )}
            </ul>
          </div>
        )
      }
    </div>
  </div>

  <!-- Marca gigante -->
  <div class="pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <p
      class="-mb-[0.2em] bg-gradient-to-b from-white/[0.17] to-white/0 bg-clip-text text-center font-serif text-[clamp(4rem,17vw,15rem)] uppercase leading-[0.9] tracking-[0.02em] text-transparent"
    >
      {brand.shortName}
    </p>
  </div>

  <!-- Barra inferior -->
  <div class="relative border-t border-white/[0.07] bg-[#0B1626]">
    <div class="container-x flex flex-col items-center justify-between gap-4 py-6 pb-24 text-[12.5px] text-white/60 sm:flex-row lg:pb-6">
      <p>© {year} {brand.name}. Todos los derechos reservados.</p>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        {footer.legal.map(link => <a href={link.href} class="transition hover:text-white">{link.label}</a>)}
        {
          brand.credit.label && (
            <a href={brand.credit.href} target="_blank" rel="noopener noreferrer" class="transition hover:text-white">
              {brand.credit.label}
            </a>
          )
        }
        <a href="#inicio" class="inline-flex items-center gap-1.5 rounded-full border border-white/15 px-3 py-1.5 text-white/70 transition hover:border-white/40 hover:text-white">
          <ArrowUp size={14} aria-hidden="true" /> Volver arriba
        </a>
      </div>
    </div>
  </div>
</footer>
