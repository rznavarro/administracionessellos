---
import { site, whatsappUrl } from '../../data/site';
import SectionHeader from '../ui/SectionHeader.astro';
import PhotoCard from '../ui/PhotoCard.astro';
import Button from '../ui/Button.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon';

const { beneficios } = site;
---

<section id="beneficios" class="cv-auto relative bg-white py-20 lg:py-24" style="--cv-h: 2300px; --cv-h-lg: 700px">
  <div class="container-x">
    <SectionHeader tag={beneficios.tag} title={beneficios.title} align="center" />

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {beneficios.items.map((item, i) => <PhotoCard foto={item.foto} alt={item.alt} title={item.title} text={item.text} delay={i * 0.06} />)}
    </div>

    <div class="rv mt-10 text-center" data-delay="0.2">
      {site.contact.whatsapp && (
      <Button href={whatsappUrl()} variant="whatsapp" size="lg" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-origen="beneficios">
        <WhatsAppIcon size={19} />
        Escribir por WhatsApp
      </Button>
    )}
    </div>
  </div>
</section>
