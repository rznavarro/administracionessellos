---
import { site } from '../../data/site';
import SectionHeader from '../ui/SectionHeader.astro';
import ModeloTimeline from '../islands/ModeloTimeline';

const { modelo } = site;
---

<section id="modelo" class="cv-auto relative overflow-hidden bg-b5 py-20 lg:py-24" style="--cv-h: 900px; --cv-h-lg: 700px">
  <div class="pointer-events-none absolute -right-40 -top-40 size-[520px] rounded-full bg-white/60 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative">
    <SectionHeader tag={modelo.tag} title={modelo.title} align="center" />
    <div class="mx-auto mt-12 max-w-2xl rounded-[28px] bg-white/70 p-6 shadow-[var(--shadow-soft)] ring-1 ring-white backdrop-blur sm:p-10">
      <ModeloTimeline client:visible={{ rootMargin: '400px' }} steps={modelo.steps} />
    </div>
  </div>
</section>
