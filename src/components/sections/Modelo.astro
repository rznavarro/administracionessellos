---
import { site } from '../../data/site';
import ModeloTimeline from '../islands/ModeloTimeline';

const { modelo } = site;
---

<section id="modelo" class="cv-auto relative overflow-hidden bg-b5 py-24 lg:py-32" style="--cv-h: 1410px; --cv-h-lg: 900px">
  <div class="pointer-events-none absolute -right-40 -top-40 size-[520px] rounded-full bg-white/60 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <p class="rv mb-4 flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-b3">
        <span class="h-px w-7 bg-b3" aria-hidden="true"></span>{modelo.tag}
      </p>
      <h2 class="rv text-balance text-[clamp(1.85rem,4.2vw,2.9rem)] font-bold leading-[1.08] tracking-[-0.03em] text-g1" data-delay="0.05">
        {modelo.title}
      </h2>
      {
        modelo.paragraphs.map((paragraph, i) => (
          <p class="rv mt-5 text-pretty text-[15.5px] leading-[1.8] text-g3" data-delay={String(0.1 + i * 0.05)}>
            {paragraph}
          </p>
        ))
      }
    </div>
    <div class="rounded-[28px] bg-white/70 p-6 shadow-[var(--shadow-soft)] ring-1 ring-white backdrop-blur sm:p-10">
      <ModeloTimeline client:visible={{ rootMargin: '400px' }} steps={modelo.steps} />
    </div>
  </div>
</section>
