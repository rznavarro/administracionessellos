---
import { Phone } from 'lucide-react';
import { site, whatsappUrl } from '../../data/site';
import MobileMenu from '../islands/MobileMenu';

const { brand, nav, contact } = site;

const mobileItems = [
  ...nav.links,
  { label: 'Preguntas frecuentes', href: '#faq' },
  { label: nav.cta.label, href: nav.cta.href }
];
const mobileContacts = [
  { label: 'WhatsApp', href: whatsappUrl() },
  { label: 'Llamar', href: contact.phoneHref },
  { label: 'Correo', href: `mailto:${contact.email}` }
];
---

<header class="site-nav on-dark fixed inset-x-0 top-0 z-50 transition-[background,box-shadow] duration-300">
  <div class="container-x flex h-[68px] items-center justify-between gap-6 lg:h-[76px]">
    <a href="#inicio" class="group flex items-center gap-3 text-white">
      <span
        class="grid size-10 shrink-0 place-items-center overflow-hidden rounded-full bg-white shadow-[0_0_0_3px_rgb(255_255_255/0.12)] transition group-hover:shadow-[0_0_0_5px_rgb(255_255_255/0.18)] lg:size-11"
      >
        <img src={brand.logo.src} width={brand.logo.width} height={brand.logo.height} alt="" class="size-[88%] object-contain" />
      </span>
      <span class="flex flex-col leading-none">
        <span class="text-[9.5px] font-semibold uppercase tracking-[0.28em] text-white/60">Administraciones</span>
        <span class="mt-1 font-serif text-[23px] italic leading-none tracking-[-0.01em]">{brand.shortName}</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-0.5 lg:flex">
      {
        nav.links.map(link => (
          <a
            href={link.href}
            class="rounded-full px-3.5 py-2 text-[13.5px] text-white/75 transition hover:bg-white/10 hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href={contact.phoneHref} class="hidden items-center gap-2 text-[13.5px] text-white/80 transition hover:text-white xl:flex">
        <Phone size={15} aria-hidden="true" />
        {contact.phoneDisplay}
      </a>
      <a
        href={nav.cta.href}
        class="rounded-xl bg-white px-5 py-2.5 text-[13.5px] font-semibold text-b1 shadow-[0_8px_24px_-10px_rgb(0_0_0/0.5)] transition hover:-translate-y-0.5"
      >
        {nav.cta.label}
      </a>
    </div>

    <!-- Espacio que ocupa el botón del menú móvil (StaggeredMenu se dibuja fijo encima) -->
    <span class="w-24 lg:hidden" aria-hidden="true"></span>
  </div>
</header>

<div class="lg:hidden">
  <MobileMenu client:media="(max-width: 1023px)" items={mobileItems} contacts={mobileContacts} />
</div>

<script>
  const header = document.querySelector<HTMLElement>('.site-nav');
  const update = () => header?.toggleAttribute('data-scrolled', window.scrollY > 24);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>
