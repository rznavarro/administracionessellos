---
import { Phone } from 'lucide-react';
import { site } from '../../data/site';

const { brand, nav, contact } = site;
---

<header class="site-nav on-dark fixed inset-x-0 top-0 z-50 transition-[background,box-shadow] duration-300">
  <div class="container-x flex h-[64px] items-center justify-between gap-4 lg:h-[76px]">
    <a href="#inicio" class="shrink-0 transition-opacity hover:opacity-85">
      <img src={brand.logo.src} width={brand.logo.width} height={brand.logo.height} alt={brand.logo.alt} class="h-8 w-auto lg:h-9" />
    </a>

    <div class="flex items-center gap-4">
      {
        contact.phoneHref && (
          <a href={contact.phoneHref} class="hidden items-center gap-2 text-[13.5px] text-white/80 transition hover:text-white sm:flex">
            <Phone size={15} aria-hidden="true" />
            {contact.phoneDisplay}
          </a>
        )
      }
      <a
        href={nav.cta.href}
        class="rounded-xl bg-white px-4 py-2.5 text-[13.5px] font-semibold text-b1 shadow-[0_8px_24px_-10px_rgb(0_0_0/0.5)] transition hover:-translate-y-0.5 lg:px-5"
      >
        {nav.cta.label}
      </a>
    </div>
  </div>
</header>

<!-- Marca en los primeros 24 px de la página: cuando sale de pantalla, el nav pasa a fondo sólido -->
<span id="nav-sentinel" class="pointer-events-none absolute inset-x-0 top-0 h-6" aria-hidden="true"></span>

<script>
  // IntersectionObserver en vez de leer scrollY: leerlo al cargar fuerza un layout de toda la página
  const header = document.querySelector<HTMLElement>('.site-nav');
  const sentinel = document.getElementById('nav-sentinel');
  if (header && sentinel) {
    new IntersectionObserver(([entry]) => header.toggleAttribute('data-scrolled', !entry.isIntersecting)).observe(sentinel);
  }
</script>
