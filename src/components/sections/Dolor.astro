---
import { ArrowRight } from 'lucide-react';
import { site } from '../../data/site';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import DolorBento from '../islands/DolorBento';

const { dolor } = site;
---

<section class="cv-auto relative bg-white py-24 lg:py-32" style="--cv-h: 2010px; --cv-h-lg: 1200px">
  <div class="container-x">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeader tag={dolor.tag} title={dolor.title} text={dolor.text} />
      <div class="rv shrink-0" data-delay="0.15">
        <Button href={dolor.cta.href} variant="secondary">
          {dolor.cta.label}
          <ArrowRight size={17} className="transition group-hover/btn:translate-x-1" />
        </Button>
      </div>
    </div>
    <div class="mt-14">
      <DolorBento client:visible={{ rootMargin: '400px' }} items={dolor.items} />
    </div>
  </div>
</section>
