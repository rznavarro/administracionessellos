---
import { MapPin } from 'lucide-react';
import { site } from '../../data/site';
import { rich } from '../../lib/rich';

const { cobertura, comunas } = site;
---

<!-- Sin comunas en site.ts no se muestra la sección -->
{
  comunas.length > 0 && (
    <section class="cv-auto on-dark relative overflow-hidden bg-b1 py-16 text-white" style="--cv-h: 360px; --cv-h-lg: 320px">
      <div class="hero-fallback pointer-events-none absolute inset-0 opacity-70" aria-hidden="true" />
      <div class="container-x relative text-center">
        <h2 class="rv text-[12px] font-semibold uppercase tracking-[0.24em] text-white/60">{cobertura.title}</h2>
        <ul class="rv mx-auto mt-6 flex max-w-3xl flex-wrap justify-center gap-2.5" data-delay="0.05">
          {comunas.map(comuna => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-white/[0.06] px-4 py-2 text-[14px] font-medium backdrop-blur">
              <MapPin size={14} className="text-[#4ADE80]" aria-hidden="true" />
              {comuna}
            </li>
          ))}
        </ul>
        <p
          class="rv mx-auto mt-7 max-w-xl text-pretty text-[15px] leading-relaxed text-white/65 [&_strong]:font-medium [&_strong]:text-white"
          data-delay="0.1"
          set:html={rich(cobertura.text)}
        />
      </div>
    </section>
  )
}
