---
import { site } from '../../data/site';
import { icons } from '../../lib/icons';
import PillarHeader from '../ui/PillarHeader.astro';
import SpotlightCard from '../reactbits/SpotlightCard';

const pilar = site.pilares.seguridad;
const accents = ['#152A45', '#7C5AA6', '#1F7A4A', '#2D6098'];
---

<section id={pilar.id} class="cv-auto relative overflow-hidden bg-g6 py-24 lg:py-32" style="--cv-h: 1780px; --cv-h-lg: 1130px">
  <div class="container-x">
    <PillarHeader badge={pilar.badge} title={pilar.title} text={pilar.text} tone="purple" />

    <div class="mt-14 grid gap-4 md:grid-cols-2">
      {
        pilar.cards.map((card, i) => {
          const Icon = icons[card.icon];
          return (
            <div class="rv h-full" data-delay={String((i % 2) * 0.08)}>
              <SpotlightCard
                client:visible
                theme="light"
                spotlightColor={accents[i]}
                intensity={0.5}
                borderGlow={0.9}
                spotlightSize={300}
                className="h-full"
                style={{ '--spotlight-card-shadow': 'var(--shadow-soft)', '--c': accents[i] } as Record<string, string>}
              >
                <span class="absolute inset-x-0 top-0 h-[3px]" style={`background: ${accents[i]}`} aria-hidden="true" />
                <span
                  class="grid size-14 place-items-center rounded-2xl text-white shadow-[0_12px_24px_-12px_var(--c)]"
                  style={`background: ${accents[i]}`}
                >
                  <Icon size={24} strokeWidth={1.8} aria-hidden="true" />
                </span>
                <h3 class="mt-6 text-[18px] font-semibold leading-snug tracking-[-0.02em] text-g1">{card.title}</h3>
                <p class="mt-2.5 text-[14.5px] leading-relaxed text-g3">{card.text}</p>
              </SpotlightCard>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
