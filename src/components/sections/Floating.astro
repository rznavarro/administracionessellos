---
import { site, whatsappUrl } from '../../data/site';
import WhatsAppIcon from '../ui/WhatsAppIcon';

const { nav, contact } = site;
---

{
  contact.whatsapp && (
    <a
      href={whatsappUrl()}
      target="_blank"
      rel="noopener noreferrer"
      data-track="whatsapp_click"
      data-origen="flotante"
      aria-label="Escríbenos por WhatsApp"
      class="animate-pulse-ring fixed bottom-6 right-6 z-40 hidden size-14 place-items-center rounded-full bg-wa text-white shadow-[0_16px_32px_-12px_rgb(37_211_102/0.7)] transition hover:scale-105 lg:grid"
    >
      <WhatsAppIcon size={28} />
    </a>
  )
}

<!-- Barra fija móvil: aparece cuando el formulario de la hero ya no está en pantalla -->
<div
  id="mobile-cta"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-g4/70 bg-white/90 px-3 pb-[max(12px,env(safe-area-inset-bottom))] pt-3 backdrop-blur-xl transition-transform duration-500 ease-out data-[show]:translate-y-0 lg:hidden"
>
  <div class="mx-auto flex max-w-md gap-2.5">
    <a href={nav.cta.href} class="flex h-12 flex-1 items-center justify-center gap-2 rounded-xl bg-b1 text-[14px] font-semibold text-white">
      {nav.cta.label}
    </a>
    {
      contact.whatsapp && (
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp_click"
          data-origen="barra_movil"
          class="flex h-12 items-center justify-center gap-2 rounded-xl bg-wa px-5 text-[14px] font-semibold text-[#073b1f]"
        >
          <WhatsAppIcon size={18} /> WhatsApp
        </a>
      )
    }
  </div>
</div>

<script>
  // Barra móvil: visible cuando ni el formulario ni el footer están en pantalla
  const bar = document.getElementById('mobile-cta');
  const form = document.getElementById('form');
  const footer = document.querySelector('footer');
  if (bar && form && 'IntersectionObserver' in window) {
    const visible = new Map<Element, boolean>();
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => visible.set(entry.target, entry.isIntersecting));
      const formOut = !visible.get(form) && window.scrollY > form.offsetTop;
      bar.toggleAttribute('data-show', formOut && !visible.get(footer as Element));
    });
    observer.observe(form);
    if (footer) observer.observe(footer);
  }

  // Medición: elementos con data-track (clics a WhatsApp, descargas) se envían a gtag si existe
  document.addEventListener('click', event => {
    const target = (event.target as Element | null)?.closest<HTMLElement>('[data-track]');
    if (!target) return;
    const gtag = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
    gtag?.('event', target.dataset.track, { origen: target.dataset.origen ?? '' });
  });
</script>
