---
import { site, whatsappUrl } from '../../data/site';
import WhatsAppIcon from '../ui/WhatsAppIcon';

const { nav, contact } = site;
---

{
  contact.whatsapp && (
    <a
      href={whatsappUrl()}
      target="_blank"
      rel="noopener noreferrer"
      data-track="whatsapp_click"
      data-origen="flotante"
      aria-label="Escríbenos por WhatsApp"
      class="animate-pulse-ring fixed bottom-6 right-6 z-40 hidden size-14 place-items-center rounded-full bg-wa text-white shadow-[0_16px_32px_-12px_rgb(37_211_102/0.7)] transition hover:scale-105 lg:grid"
    >
      <WhatsAppIcon size={28} />
    </a>
  )
}

<!-- Barra fija móvil: visible desde el inicio; se oculta mientras el formulario ocupa la pantalla o se ve el footer -->
<div
  id="mobile-cta"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-g4/70 bg-white/90 px-3 pb-[max(12px,env(safe-area-inset-bottom))] pt-3 backdrop-blur-xl transition-transform duration-500 ease-out data-[hide]:translate-y-full lg:hidden"
>
  <div class="mx-auto flex max-w-md gap-2.5">
    {
      contact.whatsapp ? (
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp_click"
          data-origen="barra_movil"
          class="flex h-12 flex-1 items-center justify-center gap-2 rounded-xl bg-wa text-[14px] font-semibold text-[#073b1f]"
        >
          <WhatsAppIcon size={18} /> Escribir por WhatsApp
        </a>
      ) : (
        <a href={nav.cta.href} class="flex h-12 flex-1 items-center justify-center gap-2 rounded-xl bg-b1 text-[14px] font-semibold text-white">
          {nav.cta.label}
        </a>
      )
    }
  </div>
</div>

<script>
  // Barra móvil: oculta mientras el formulario está más de la mitad en pantalla o el footer es visible
  const bar = document.getElementById('mobile-cta');
  const form = document.getElementById('form');
  const footer = document.querySelector('footer');
  if (bar && form && 'IntersectionObserver' in window) {
    const latest = new Map<Element, IntersectionObserverEntry>();
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => latest.set(entry.target, entry));
        const formCovers = (latest.get(form)?.intersectionRatio ?? 0) > 0.5;
        const footerShown = latest.get(footer as Element)?.isIntersecting ?? false;
        bar.toggleAttribute('data-hide', formCovers || footerShown);
      },
      { threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    observer.observe(form);
    if (footer) observer.observe(footer);
  }

  // Medición: elementos con data-track (clics a WhatsApp, descargas) se envían a gtag si existe
  document.addEventListener('click', event => {
    const target = (event.target as Element | null)?.closest<HTMLElement>('[data-track]');
    if (!target) return;
    const gtag = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
    gtag?.('event', target.dataset.track, { origen: target.dataset.origen ?? '' });
  });
</script>
