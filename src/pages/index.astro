import PilarFinanzas from '../components/sections/PilarFinanzas.astro';
import PilarSeguridad from '../components/sections/PilarSeguridad.astro';
import GastoComun from '../components/sections/GastoComun.astro';
import Testimonios from '../components/sections/Testimonios.astro';
import Autoevaluacion from '../components/sections/Autoevaluacion.astro';
