---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Beneficios from '../components/sections/Beneficios.astro';
import Modelo from '../components/sections/Modelo.astro';
import Testimonios from '../components/sections/Testimonios.astro';
import Cobertura from '../components/sections/Cobertura.astro';
import Faq from '../components/sections/Faq.astro';
import CtaFinal from '../components/sections/CtaFinal.astro';
import Recursos from '../components/sections/Recursos.astro';
import Footer from '../components/sections/Footer.astro';
import Floating from '../components/sections/Floating.astro';
---

<Base>
  <Nav />
  <main>
    <Hero />
    <Beneficios />
    <Modelo />
    <!-- Testimonios, cobertura y recursos se muestran solo cuando tienen datos en site.ts -->
    <Testimonios />
    <Cobertura />
    <Faq />
    <CtaFinal />
    <Recursos />
  </main>
  <Footer />
  <Floating />
</Base>
